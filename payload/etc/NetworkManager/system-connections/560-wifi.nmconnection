[connection]
id=560
uuid=9a1d2f43-6b17-4f2e-8c6d-3e5a1b7c9d21
type=wifi
autoconnect=true
autoconnect-priority=20
autoconnect-retries=0

[wifi]
mode=infrastructure
ssid=560
band=bg
# ★ 固定 MAC：ath10k 从固件里读到的是"无效 MAC"，驱动会 eth_random_addr() 随机一个
#   （内核日志 "invalid MAC address; choosing random"）。随机值虽然因为早期无熵源
#   而恰好每次都一样，但那是"碰巧"，不能依赖。这里显式固定，路由器就始终认同一个设备。
cloned-mac-address=02:00:71:96:e3:d6

[wifi-security]
key-mgmt=wpa-psk
psk=changeme123

[ipv4]
method=auto

[ipv6]
method=auto
addr-gen-mode=stable-privacy
