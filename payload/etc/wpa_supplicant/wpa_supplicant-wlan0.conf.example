# /etc/wpa_supplicant/wpa_supplicant-wlan0.conf
# 由 wpa_supplicant@wlan0.service 读取（Ubuntu/Debian 的模板单元）。
#
# ★ 2026-10-18 起 WiFi 主路径是 NetworkManager：档案
#     /etc/NetworkManager/system-connections/560-wifi.nmconnection（autoconnect=yes）
#   而 wpa_supplicant@wlan0.service 在设备上是 **masked** 的，所以这份文件正常
#   不会被用到；它只是"万一有人手工 systemctl start wpa_supplicant@wlan0"时的兜底。
#   因此这里写实测可用的 2.4G SSID 560，不要再写 560_5G ——
#   560_5G 在 ch44（CN 域是 [RADAR]/DFS），STA 侧握手完不成，见 docs/root-cause.md。
ctrl_interface=DIR=/run/wpa_supplicant GROUP=netdev
update_config=1
country=CN

network={
	ssid="560"
	psk="changeme123"
	# 只扫 2.4G 信道，省得去扫 5G（那只会白等）
	scan_freq=2412 2437 2462 2472
}
