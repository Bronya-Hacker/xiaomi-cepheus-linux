[Unit]
Description=Mi9 WirePlumber session manager
After=mi9-pipewire.service mi9-session-dbus.service
Requires=mi9-pipewire.service

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus
ExecStart=/usr/bin/wireplumber
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target