#include <dt-bindings/sound/qcom,q6afe.h>
#include <dt-bindings/sound/qcom,q6asm.h>
#include <dt-bindings/sound/qcom,wcd934x.h>
/*
 * Xiaomi Mi 9 (cepheus) —�?相机 / 红外 / NFC 的板级补�? *
 * �?scripts/apply-dts5.sh 追加�?sm8150-xiaomi-cepheus.dts 末尾�? * 这样 07-rebuild-all 之类的完整重建不会把它冲掉�? *
 * 相机部分目前状态：SoC 侧全部打通（时钟/GDSC/CCI/camss），
 * 但模组本身不上电，详�?docs/camera-port.md §15�? */

/ {
	/* 相机 VIO�?.8V，GPIO132 使能（原�?camera_viodd_ldo�?*/
	cam_vio: regulator-cam-vio {
		compatible = "regulator-fixed";
		regulator-name = "cam_vio";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-enable-ramp-delay = <135>;
		enable-active-high;
		gpio = <&tlmm 132 GPIO_ACTIVE_HIGH>;
		regulator-always-on;
	};

	/* 红外发射管的供电（ir-spi 驱动要求名为 irda_regulator 的电源） */
	ir_vreg: regulator-ir {
		compatible = "regulator-fixed";
		regulator-name = "ir_vreg";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

/* ================= 相机 ================= */

&camss {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			csiphy1_in: endpoint {
				remote-endpoint = <&imx586_out>;
				bus-type = <4>;
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <400000000>;
			};
		};
	};
};

&cci1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&cci1_i2c1_default>;
};

&cci1_i2c1 {
	status = "okay";

	imx586: camera@1a {
		compatible = "sony,imx586";
		reg = <0x1a>;

		reset-gpios = <&tlmm 30 GPIO_ACTIVE_HIGH>;
		pwdn-gpios = <&tlmm 59 GPIO_ACTIVE_HIGH>;

		clocks = <&camcc CAM_CC_MCLK1_CLK>;
		clock-names = "xvclk";

		pinctrl-names = "default", "suspend";
		pinctrl-0 = <&cam_mclk0_active &cam_reset0_active &cam_vdig0_active>;
		pinctrl-1 = <&cam_mclk0_suspend>;

		/* IMX586：AVDD 2.8V、DOVDD 1.8V、DVDD 1.1�?.9V
		 * 原厂 DT 命名是反的（cam_vdig 2.856V 才是 AVDD�?		 */
		avdd-supply = <&vreg_l17a_3p0>;
		dovdd-supply = <&cam_vio>;
		dvdd-supply = <&vreg_s5a_1p9>;

		port {
			imx586_out: endpoint {
				remote-endpoint = <&csiphy1_in>;
				bus-type = <4>;
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <400000000>;
			};
		};
	};
};

&tlmm {
	cam_mclk0_active: cam-mclk0-active {
		pins = "gpio14";
		function = "cam_mclk";
		drive-strength = <2>;
		bias-disable;
	};

	cam_mclk0_suspend: cam-mclk0-suspend {
		pins = "gpio14";
		function = "cam_mclk";
		drive-strength = <2>;
		bias-pull-down;
	};

	cam_reset0_active: cam-reset0-active {
		pins = "gpio30";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	cam_vdig0_active: cam-vdig0-active {
		pins = "gpio59";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	cci1_i2c1_default: cci1-i2c1-default {
		pins = "gpio31", "gpio32", "gpio33", "gpio34";
		function = "cci_i2c";
		drive-strength = <2>;
		bias-disable;
	};
};

/* ================= 红外（SPI1 / QUP S1, gpio114-117�?================= */

/* QUP �?GPI DMA（geni-i2c/spi 需要） */
&gpi_dma0 {
	status = "okay";
};

&gpi_dma1 {
	status = "okay";
};

/* IR �?qupv3_id_0（geniqup@8c0000）下�?spi1 */
&qupv3_id_0 {
	status = "okay";
};

&spi1 {
	status = "okay";

	irled: ir@0 {
		compatible = "ir-spi-led";
		reg = <0>;
		spi-max-frequency = <19200000>;
		irda_regulator-supply = <&ir_vreg>;
	};
};

/* ================= NFC（NXP NQ, i2c9, 地址 0x28�?================= */

&tlmm {
	nfc_int_active: nfc-int-active {
		pins = "gpio47";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	nfc_enable_active: nfc-enable-active {
		pins = "gpio103";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	nfc_firm_active: nfc-firm-active {
		pins = "gpio48";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	/* ԭ���� NFC �� CLKREQ �ţ�GPIO113����ɴ����������룬
	 * ����Ļ���������գ�оƬ�ò����ο�ʱ�ӣ�I2C ��ֱ����Ӧ��-121����
	 */
	nfc_clkreq_active: nfc-clkreq-active {
		pins = "gpio113";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};};

/* NFC �?qupv3_id_1（geniqup@ac0000）下�?i2c9 */
&qupv3_id_1 {
	status = "okay";
};

&i2c9 {
	status = "okay";
	/* SN100U �ϵ�������� 100kHz���ų������ʵ��µĲ���Ӧ */
	clock-frequency = <100000>;

	nfc: nq@28 {
		compatible = "nxp,nxp-nci-i2c";
		reg = <0x28>;

		interrupt-parent = <&tlmm>;
		/* NXP NQ �?IRQ 必须用边沿触发：芯片数据没被读走时会把线一直拉高，
	 * 用电平触发会造成中断风暴把系统卡死�?*/
		interrupts = <47 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "nfc_irq";

		enable-gpios = <&tlmm 103 GPIO_ACTIVE_HIGH>;
		firmware-gpios = <&tlmm 48 GPIO_ACTIVE_HIGH>;

		/* SN100U �Ĳο�ʱ������ PMIC �� ln_bb_clk3��19.2MHz����
		 * CLKREQ һֱ���ͱ�ʾ������ʱ�ӣ�ûʱ��оƬ����ȫ����Ӧ NCI��
		 */
		clocks = <&rpmhcc RPMH_LN_BB_CLK3>;
		clock-names = "nfc_clk";

		pinctrl-names = "default";
		pinctrl-0 = <&nfc_int_active &nfc_enable_active &nfc_firm_active &nfc_clkreq_active>;
	};
};

/* ================= 音频：WCD9340（原�?tavil�?================= */
/* 原厂接线：codec IRQ=GPIO123，复�?GPIO143（低有效复位，驱动自己控制）
 * 电源：vdd-buck/tx/rx/io = pm8150 S4�?.8V），vdd-vbat/3v3 = BOB
 */

&tlmm {
	wcd_intr_default: wcd-intr-default {
		pins = "gpio123";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	wcd_rst_n_active: wcd-rst-n-active {
		pins = "gpio143";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

&slim {
	status = "okay";

	slim@1 {
		reg = <1>;
		#address-cells = <2>;
		#size-cells = <0>;

		wcd9340_ifd: ifd@0,0 {
			compatible = "slim217,250";
			reg = <0 0>;
		};

		wcd9340: codec@1,0 {
			compatible = "slim217,250";
			reg = <1 0>;
			slim-ifc-dev = <&wcd9340_ifd>;

			#sound-dai-cells = <1>;

			interrupts-extended = <&tlmm 123 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			#interrupt-cells = <1>;

			reset-gpios = <&tlmm 143 GPIO_ACTIVE_HIGH>;

			clock-names = "extclk";
			clocks = <&rpmhcc RPMH_LN_BB_CLK2>;
			#clock-cells = <0>;
			clock-frequency = <9600000>;
			clock-output-names = "mclk";

			pinctrl-names = "default";
			pinctrl-0 = <&wcd_intr_default &wcd_rst_n_active>;

			vdd-buck-supply = <&vreg_s4a_1p8>;
			vdd-buck-sido-supply = <&vreg_s4a_1p8>;
			vdd-tx-supply = <&vreg_s4a_1p8>;
			vdd-rx-supply = <&vreg_s4a_1p8>;
			vdd-io-supply = <&vreg_s4a_1p8>;
			vdd-micbias-supply = <&vreg_s4a_1p8>;
			vdd-vbat-supply = <&vreg_bob>;

			qcom,micbias1-microvolt = <1800000>;
			qcom,micbias2-microvolt = <1800000>;
			qcom,micbias3-microvolt = <1800000>;
			qcom,micbias4-microvolt = <1800000>;

			#address-cells = <1>;
			#size-cells = <1>;

			wcdgpio: gpio-controller@42 {
				compatible = "qcom,wcd9340-gpio";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x42 0x2>;
			};

			swm: soundwire@c85 {
				compatible = "qcom,soundwire-v1.3.0";
				reg = <0xc85 0x40>;
				interrupts-extended = <&wcd9340 20>;

				qcom,dout-ports = <6>;
				qcom,din-ports = <2>;
				qcom,ports-sinterval-low = /bits/ 8 <0x07 0x1f 0x3f 0x07 0x1f 0x3f 0x0f 0x0f>;
				qcom,ports-offset1 = /bits/ 8 <0x01 0x02 0x0c 0x06 0x12 0x0d 0x07 0x0a>;
				qcom,ports-offset2 = /bits/ 8 <0x00 0x00 0x1f 0x00 0x00 0x1f 0x00 0x00>;

				#sound-dai-cells = <1>;
				clocks = <&wcd9340>;
				clock-names = "iface";
				#address-cells = <2>;
				#size-cells = <0>;
			};
		};
	};
};

/* ================= 声卡 ================= */


/* secondary MI2S �?SD 线：原厂两路 SD0(GPIO128)/SD1(GPIO129)�? * 没有这个属�?q6afe �?sd_line_mask 就是 0，prepare �?-22�? */
&q6afedai {
	dai@22 {
		reg = <QUATERNARY_MI2S_RX>;
		qcom,sd-lines = <0>;
	};
};

&sound {
	compatible = "qcom,sm8150-sndcard";
	model = "sm8150-tavil-snd-card";
	status = "okay";

	audio-routing =
		"RX_BIAS", "MCLK",
		"AMIC1", "MIC BIAS1",
		"AMIC2", "MIC BIAS2",
		"AMIC3", "MIC BIAS2",
		"AMIC4", "MIC BIAS2",
		"DMIC0", "MCLK",
		"DMIC0", "MIC BIAS1",
		"DMIC2", "MCLK",
		"DMIC2", "MIC BIAS3";

	mm1-dai-link {
		link-name = "MultiMedia1";
		cpu { sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>; };
	};
	mm2-dai-link {
		link-name = "MultiMedia2";
		cpu { sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>; };
	};
	mm3-dai-link {
		link-name = "MultiMedia3";
		cpu { sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>; };
	};
	mm4-dai-link {
		link-name = "MultiMedia4";
		cpu { sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA4>; };
	};
	mm5-dai-link {
		link-name = "MultiMedia5";
		cpu { sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA5>; };
	};

	slim-dai-link {
		link-name = "SLIM Playback 1";
		no-pcm;
		codec { sound-dai = <&wcd9340 AIF1_PB>; };
		cpu { sound-dai = <&q6afedai SLIMBUS_0_RX>; };
		platform { sound-dai = <&q6routing>; };
	};

	slimcap-dai-link {
		link-name = "SLIM Capture 1";
		no-pcm;
		codec { sound-dai = <&wcd9340 AIF1_CAP>; };
		cpu { sound-dai = <&q6afedai SLIMBUS_0_TX>; };
		platform { sound-dai = <&q6routing>; };
	};

	/* �?采集端口排查用：把另外几�?SLIM TX 端口也挂上同一�?codec 采集 DAI�?	 * 用来确认麦克风到底走的是哪个 AFE SLIM 端口�?026-10-21）�?	 */
	slimcap2-dai-link {
		link-name = "SLIM Capture 2";
		no-pcm;
		codec { sound-dai = <&wcd9340 AIF1_CAP>; };
		cpu { sound-dai = <&q6afedai SLIMBUS_1_TX>; };
		platform { sound-dai = <&q6routing>; };
	};

	slimcap3-dai-link {
		link-name = "SLIM Capture 3";
		no-pcm;
		codec { sound-dai = <&wcd9340 AIF1_CAP>; };
		cpu { sound-dai = <&q6afedai SLIMBUS_2_TX>; };
		platform { sound-dai = <&q6routing>; };
	};

	/* 扬声器：AFE secondary MI2S -> CS35L41 -> 喇叭 */
	mi2s-spk-dai-link {
		link-name = "SEC MI2S Playback";
		no-pcm;

		codec { sound-dai = <&speaker_amp 0>; };
		cpu { sound-dai = <&q6afedai QUATERNARY_MI2S_RX>; };
		platform { sound-dai = <&q6routing>; };
	};

};

/* q6asm-dai 需要子节点，否则报 "No dais found in DT" */
&q6asmdai {
	dai@0 { reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>; };
	dai@1 { reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>; };
	dai@2 { reg = <MSM_FRONTEND_DAI_MULTIMEDIA3>; };
	dai@3 { reg = <MSM_FRONTEND_DAI_MULTIMEDIA4>; };
	dai@4 { reg = <MSM_FRONTEND_DAI_MULTIMEDIA5>; };
	dai@5 { reg = <MSM_FRONTEND_DAI_MULTIMEDIA6>; };
	dai@6 { reg = <MSM_FRONTEND_DAI_MULTIMEDIA7>; };
	dai@7 { reg = <MSM_FRONTEND_DAI_MULTIMEDIA8>; };
};

/* apr 音频服务需要挂�?ADSP �?audio protection domain�? * 否则 q6asm �?buffer memory-map 会被 DSP 拒绝（error 1）�? * sdm845/sm8250 的主�?DT 都有这个属性，sm8150 �?dtsi 漏了�? */
&q6afe {
	qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";
};

&q6asm {
	qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";
};

&q6adm {
	qcom,protection-domain = "avs/audio", "msm/adsp/audio_pd";
};

/* ================= 扬声器功放：Cirrus CS35L41 =================
 * 原厂 DT：i2c@890000（主�?i2c4）地址 0x40，复�?GPIO89（低有效），
 * 中断 GPIO10（低电平）。主线有 cs35l41 驱动且已编成模块�? * 注意：只开这一条总线 —�?之前一次性打开所�?QUP 总线导致无法开机�? */
&i2c4 {
	status = "okay";

	speaker_amp: speaker-amp@40 {
		compatible = "cirrus,cs35l41";
		reg = <0x40>;
		#sound-dai-cells = <1>;

		/* 主线 cs35l41 驱动假设复位是高有效：先拉低 2ms 再拉高释放�?		 * 原来按原厂语义写�?ACTIVE_LOW，逻辑 1 反而变成物理低�?		 * 等于一直按着复位，芯片永远等不到 OTP_BOOT_DONE�?		 */
		VA-supply = <&vreg_s4a_1p8>;
		VP-supply = <&vreg_bob>;
		/* 功放�?I2S 引脚复用（qua_mi2s�?36 MCLK / 137-140 数据�?*/
		pinctrl-names = "default";
		pinctrl-0 = <&quat_mi2s_active>;

		reset-gpios = <&tlmm 89 GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&tlmm>;
		interrupts = <10 IRQ_TYPE_LEVEL_LOW>;

		cirrus,boost-peak-milliamp = <4000>;
		cirrus,boost-ind-nanohenry = <1000>;
		cirrus,boost-cap-microfarad = <15>;
		/* 原厂�?cirrus,gpio-config2: gpio-src-select=4 + output-enable */
		cirrus,gpio2-src-select = <4>;
		cirrus,gpio2-output-enable;
	};
};

/* 扬声器功放的音频输入：secondary MI2S（原�?gpio126-129�?*/
&tlmm {
	quat_mi2s_active: quat-mi2s-active {
		pins = "gpio136", "gpio137", "gpio138", "gpio139", "gpio140";
		function = "qua_mi2s";
		drive-strength = <8>;
		bias-disable;
	};
};
