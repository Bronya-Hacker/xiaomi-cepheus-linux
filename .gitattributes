* text=auto eol=lf

# 构建脚本必须是 LF（CRLF 会让设备上的 bash 报 $'\r': command not found）
*.sh    text eol=lf
*.dts   text eol=lf
*.dtsi  text eol=lf
*.patch text eol=lf
*.conf  text eol=lf

# Windows 侧脚本保持 CRLF
# *.bat 是给 cmd.exe 跑的：LF 换行的批处理在 goto/label 上会出怪事，
# 而且 2026-10-20 发现 .gitattributes 里漏了这条，clone 下来再打包就会得到 LF。
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.img   binary
*.bin   binary
*.mbn   binary
*.tlv   binary
*.gz    binary
*.zst   binary
*.so*   binary

# 无扩展名的 ELF（tqftpserv 等）与固件目录整体按二进制处理
payload/usr/bin/*                   binary
payload/usr/lib/tqftpserv-bundle/*  binary
payload/lib/firmware/**             binary
